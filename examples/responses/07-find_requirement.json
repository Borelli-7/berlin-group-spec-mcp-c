      ],
      "related_endpoints": [
        "POST /v2/consents/account-access",
        "POST /v2/consents/account-access"
      ],
      "acceptance_criteria": [
        {
          "id": "OFV2-CONSENT-AIS-001/AC1",
          "requirement_id": "OFV2-CONSENT-AIS-001",
          "text": "access, consentType, recurringIndicator, validTo and frequencyPerDay are mandatory in the request body.",
          "mapping": {
            "file": "requirements/requirements.yaml",
            "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
            "locator": "requirement:OFV2-CONSENT-AIS-001",
            "sha256": "b8336d107c307e4cb51be32363eacde5530e52a6501e8c06f9645bc607a6fb73"
          }
        },
        {
          "id": "OFV2-CONSENT-AIS-001/AC2",
          "requirement_id": "OFV2-CONSENT-AIS-001",
          "text": "frequencyPerDay is at least 1 and, unless agreed bilaterally, at most 4; a one-off access uses 1.",
          "mapping": {
            "file": "requirements/requirements.yaml",
            "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
            "locator": "requirement:OFV2-CONSENT-AIS-001",
            "sha256": "b8336d107c307e4cb51be32363eacde5530e52a6501e8c06f9645bc607a6fb73"
          }
        },
        {
          "id": "OFV2-CONSENT-AIS-001/AC3",
          "requirement_id": "OFV2-CONSENT-AIS-001",
          "text": "validTo \"9999-12-31\" requests the maximum validity; the ASPSP may adjust the date.",
          "mapping": {
            "file": "requirements/requirements.yaml",
            "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
            "locator": "requirement:OFV2-CONSENT-AIS-001",
            "sha256": "b8336d107c307e4cb51be32363eacde5530e52a6501e8c06f9645bc607a6fb73"
          }
        },
        {
          "id": "OFV2-CONSENT-AIS-001/AC4",
          "requirement_id": "OFV2-CONSENT-AIS-001",
          "text": "consentType \"detailed\" is supported by every ASPSP.",
          "mapping": {
            "file": "requirements/requirements.yaml",
            "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
            "locator": "requirement:OFV2-CONSENT-AIS-001",
            "sha256": "b8336d107c307e4cb51be32363eacde5530e52a6501e8c06f9645bc607a6fb73"
          }
        },
        {
          "id": "OFV2-CONSENT-AIS-001/AC5",
          "requirement_id": "OFV2-CONSENT-AIS-001",
          "text": "A successful response has HTTP 201 and contains consentStatus and consentId.",
          "mapping": {
            "file": "requirements/requirements.yaml",
            "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
            "locator": "requirement:OFV2-CONSENT-AIS-001",
            "sha256": "b8336d107c307e4cb51be32363eacde5530e52a6501e8c06f9645bc607a6fb73"
          }
        },
        {
          "id": "OFV2-CONSENT-AIS-001/AC6",
          "requirement_id": "OFV2-CONSENT-AIS-001",
          "text": "An authorised recurring consent lets a former recurring consent of the same PSU and API Client expire, unless the Multiple Consents Service is offered.",
          "mapping": {
            "file": "requirements/requirements.yaml",
            "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
            "locator": "requirement:OFV2-CONSENT-AIS-001",
            "sha256": "b8336d107c307e4cb51be32363eacde5530e52a6501e8c06f9645bc607a6fb73"
          }
        }
      ],
      "mapping": {
        "file": "requirements/requirements.yaml",
        "file_sha256": "27d8c3ca4a5b7e1ec82a073e9bfa08a3f0bbc235925e279bf4403b6fc6abfd9f",
