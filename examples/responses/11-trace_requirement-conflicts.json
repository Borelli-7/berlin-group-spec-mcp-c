    "acceptance_criteria": [
      "ASPSP-SCA-Approach is contained if the SCA approach is already fixed.",
      "Permitted values are EMBEDDED, DECOUPLED, REDIRECT, ASPSP-CHANNEL and SIGNATURE.",
      "The OAuth SCA approach is reported as REDIRECT."
    ],
