{
  "requirement_id": "OFV2-AIS-TRANSACTIONS-001",
  "classification": "authoritative_requirement",
  "requirement": {
    "id": "OFV2-AIS-TRANSACTIONS-001",
    "version": "openfinance-v2",
    "title": "Read transaction list with mandatory bookingStatus and conditional dateFrom",
    "description": "GET /v2/accounts/{account-id}/transactions reads booked or pending transactions or standing orders of an account. bookingStatus is mandatory; dateFrom is mandated unless a delta access is used or bookingStatus equals \"information\".",
    "sources": [
      {
        "source_id": "bg-openfinance-v2-xs2a-implementation-guidelines",
        "locator": "section:4.4.4",
        "note": "Read Transaction List"
      },
      {
        "source_id": "bg-openfinance-v2-xs2a-implementation-guidelines",
        "locator": "page:95-101"
      },
      {
        "source_id": "bg-openfinance-v2-xs2a-operational-rules",
        "locator": "section:4.10",
        "note": "API Service Get transaction information for a given account"
      },
      {
        "source_id": "bg-openfinance-v2-data-dictionary",
        "locator": "page:200",
        "note": "FORMAT_ERROR"
      },
      {
        "source_id": "bg-openfinance-v2-openapi-ais",
        "locator": "op:GET /v2/accounts/{account-id}/transactions"
      }
    ],
    "endpoints": [
      "GET /v2/accounts/{account-id}/transactions"
    ],
    "schemas": [
      "accountReport",
      "transactions"
    ],
    "acceptance_criteria": [
      "A request without the bookingStatus query parameter is rejected with HTTP 400 FORMAT_ERROR.",
      "bookingStatus \"booked\" is supported; \"pending\" is supported if the ASPSP online channels show pending transactions.",
      "bookingStatus \"both\", \"information\" and \"all\" are optional; an unsupported value is answered with an error code.",
      "dateFrom is mandatory unless deltaList or entryReferenceFrom is used or bookingStatus equals \"information\".",
      "If dateTo is absent, \"today\" is used as end date.",
      "For bookingStatus \"information\", dateFrom, dateTo, withBalance, deltaList and entryReferenceFrom have no effect.",
      "A successful response has HTTP 200 and contains the mandatory account reference."
    ],
    "conflicts_with": [],
    "tags": [
      "ais",
      "transactions"
    ]
  },
