{
  "requirement_id": "OFV2-TRANSACTIONS-001",
  "classification": "authoritative_requirement",
  "requirement": {
    "id": "OFV2-TRANSACTIONS-001",
    "version": "openfinance-v2",
    "title": "Read transaction list with mandatory bookingStatus and dateFrom",
    "description": "The ASPSP exposes GET /accounts/{accountId}/transactions. bookingStatus and dateFrom are mandatory query parameters; responses are paginated.",
    "sources": [
      {
        "source_id": "bg-openfinance-v2-implementation-guidelines",
        "locator": "section:4.2",
        "note": "Read Transaction List"
      },
      {
        "source_id": "bg-openfinance-v2-implementation-guidelines",
        "locator": "page:3"
      },
      {
        "source_id": "bg-openfinance-v2-openapi",
        "locator": "op:GET /accounts/{accountId}/transactions"
      }
    ],
    "endpoints": [
      "GET /accounts/{accountId}/transactions"
    ],
    "schemas": [
      "TransactionsResponse200Json",
      "BookingStatus"
    ],
    "acceptance_criteria": [
      "A request without bookingStatus is rejected with HTTP 400.",
      "The values booked, pending and both of bookingStatus are supported.",
      "A request without dateFrom (and without deltaList) is rejected with HTTP 400 FORMAT_ERROR.",
      "When more entries exist than fit into one page, the response contains _links.next.",
      "The optional pageSize query parameter limits the number of returned entries."
    ],
    "conflicts_with": [],
    "tags": [
      "ais",
      "transactions"
    ]
  },
  "mapping": {
    "file": "requirements/requirements.yaml",
    "file_sha256": "91f9b55e4d5f1b425fe608d1e6442edfdf06e9f2749b02ebe53d781b477da13c",
    "locator": "requirement:OFV2-TRANSACTIONS-001",
    "sha256": "6d38e62564e29dd26b5c469f8ad55e2ca6cdadc375895976383d490227e7799c"
  },
  "sources": [
    {
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "locator": "section:4.2",
      "note": "Read Transaction List",
      "status": "resolved",
      "document": {
        "title": "Open Finance v2 Implementation Guidelines (synthetic fixture)",
        "kind": "pdf",
        "version": "openfinance-v2",
        "authority": "normative",
        "precedence": 100,
        "sha256": "8eec1c4376ce0a3155981597e953208585e80d986308bd69593d4a4b86949d5b",
        "status": "partial"
      },
      "excerpt": "4.2 Read Transaction List\n\nCall GET /accounts/{accountId}/transactions reads the transaction list of an addressed\naccount.\n\nThe query parameter bookingStatus is mandatory. The ASPSP SHALL support the values booked,\npending and both. The ASPSP MAY support the values information and all. If the value\ninformation is used, the ASPSP SHALL return standing order information instead of\ntransactions.\n\nThe query parameter dateFrom is mandatory unless deltaList is used. The ASPSP SHALL reject a\nrequest without dateFrom with HTTP status 400 and error code FORMAT_ERROR.\n\nThe ASPSP SHALL support the pagination of transaction lists. The TPP MAY limit the page size\nwith the query parameter pageSize. The ASPSP SHALL return a link next when more entries\nexist.\n\nThe ASPSP SHALL return HTTP status 429 with error code ACCESS_EXCEEDED when the access\nfrequency limit of the consent is exceeded.\n\nEach returned transaction MUST contain transactionAmount and bookingDate. The bookingDate is\nreturned as date-time in version 2.",
      "provenance": [
        {
          "source_id": "bg-openfinance-v2-implementation-guidelines",
          "document_id": "bg-openfinance-v2-implementation-guidelines@8eec1c4376ce",
          "version": "openfinance-v2",
          "kind": "pdf",
          "authority": "normative",
          "precedence": 100,
          "locator": "chunk:bg-openfinance-v2-implementation-guidelines:p3:c0",
          "sha256": "ffb004d5d4d60493cbcc67cbdf923ef7f782113b7492240ba869ba9de5de294a",
          "document_sha256": "8eec1c4376ce0a3155981597e953208585e80d986308bd69593d4a4b86949d5b"
        }
      ]
    },
    {
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "locator": "page:3",
      "status": "resolved",
      "document": {
        "title": "Open Finance v2 Implementation Guidelines (synthetic fixture)",
        "kind": "pdf",
        "version": "openfinance-v2",
        "authority": "normative",
