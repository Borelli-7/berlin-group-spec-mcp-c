  "related_evidence": [
    {
      "record_id": "bg-openfinance-v2-implementation-guidelines:p3:c0",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "document_id": "bg-openfinance-v2-implementation-guidelines@8eec1c4376ce",
      "version": "openfinance-v2",
      "kind": "pdf",
      "authority": "normative",
      "title": "Open Finance v2 Implementation Guidelines (synthetic fixture) — 4.2 Read Transaction List",
      "locator": "chunk:bg-openfinance-v2-implementation-guidelines:p3:c0",
      "page": 3,
      "evidence": "4.2 Read Transaction List\n\nCall GET /accounts/{accountId}/transactions reads the transaction list of an addressed\naccount.\n\nThe query parameter bookingStatus is mandatory. The ASPSP SHALL support the values booked,\npending and both. The ASPSP MAY support the values information and all. If the value\ninformation is used, the ASPSP SHALL return standing order information instead of\ntransactions.\n\nThe",
      "relevance": 22.687999725341797,
      "sha256": "ffb004d5d4d60493cbcc67cbdf923ef7f782113b7492240ba869ba9de5de294a",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-errata:p1:c1",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-errata",
      "document_id": "bg-openfinance-v2-errata@809757ca2bde",
      "version": "openfinance-v2",
      "kind": "text",
      "authority": "informative",
      "title": "Open Finance v2 Errata and Clarifications (synthetic fixture) — E-07 Transaction list access frequency",
      "locator": "chunk:bg-openfinance-v2-errata:p1:c1",
      "page": 1,
      "evidence": "E-07 Transaction list access frequency\n\nClarification: the limit of four transaction list reads per calendar day without PSU\ninvolvement is counted per consent only, not per account",
      "relevance": 22.628999710083008,
      "sha256": "dfa8ea7a43492195dc217d436f78b8ee9b2410bb56c56ec34d556d1ecc2d1959",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-implementation-guidelines:p5:c0",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "document_id": "bg-openfinance-v2-implementation-guidelines@8eec1c4376ce",
      "version": "openfinance-v2",
      "kind": "pdf",
      "authority": "normative",
      "title": "Open Finance v2 Implementation Guidelines (synthetic fixture) — 4.3 Read Transaction Details",
      "locator": "chunk:bg-openfinance-v2-implementation-guidelines:p5:c0",
      "page": 5,
      "evidence": "4.3 Read Transaction Details\n\nCall GET /accounts/{accountId}/transactions/{transactionId} reads the details of one\ntransaction. The ASPSP SHALL return HTTP status 404 if the transactionId is unknown",
      "relevance": 17.52199935913086,
      "sha256": "d2aaf0f1aa71da8795ab975e8126c21a8466627d20fd5c56b48f79153d321ae9",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-operational-rules:p2:c0",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-operational-rules",
      "document_id": "bg-openfinance-v2-operational-rules@80430186dc34",
      "version": "openfinance-v2",
      "kind": "pdf",
      "authority": "normative",
      "title": "Open Finance v2 Operational Rules (synthetic fixture) — 3 Transaction History Access",
      "locator": "chunk:bg-openfinance-v2-operational-rules:p2:c0",
      "page": 2,
      "evidence": "3 Transaction History Access\n\nThe ASPSP SHALL make at least 90 days of transaction history available through the\ntransaction list endpoint.\n\nWithout active PSU involvement the TPP MUST NOT read the transaction list of an account more\nthan four times per calendar day. The limit is counted per account and per consent",
      "relevance": 17.35700035095215,
      "sha256": "07fcee82a83b379bc569924f5a6cc45ee1bfe4abb2036222fb4c6fcd24093ec8",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-implementation-guidelines:p5:c1",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "document_id": "bg-openfinance-v2-implementation-guidelines@8eec1c4376ce",
      "version": "openfinance-v2",
      "kind": "pdf",
      "authority": "normative",
      "title": "Open Finance v2 Implementation Guidelines (synthetic fixture) — 4.4 Read Balance",
      "locator": "chunk:bg-openfinance-v2-implementation-guidelines:p5:c1",
      "page": 5,
      "evidence": "4.4 Read Balance\n\nCall GET /accounts/{accountId}/balances reads the balances of an account. The ASPSP SHALL\nreturn at least one balance of type closingBooked or interimAvailable",
      "relevance": 9.25,
      "sha256": "9595e44b3940bf3735960e38868c4ff8968f511bc53c414e5caf8ff73a45553e",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-implementation-guidelines:p2:c0",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "document_id": "bg-openfinance-v2-implementation-guidelines@8eec1c4376ce",
      "version": "openfinance-v2",
      "kind": "pdf",
      "authority": "normative",
      "title": "Open Finance v2 Implementation Guidelines (synthetic fixture) — 1 Introduction",
      "locator": "chunk:bg-openfinance-v2-implementation-guidelines:p2:c0",
      "page": 2,
      "evidence": "1 Introduction\n\nThis document describes the account information interface of the synthetic Open Finance\nFramework version 2. Version 2 extends version 1.3 and keeps the version 1.3 interface\navailable for existing TPPs",
      "relevance": 4.7230000495910645,
      "sha256": "36a3f3c5a55e2fb01c310920ebe5ad36d490dc65eaf98a9685f4c573a26ff00b",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-implementation-guidelines:p1:c0",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-implementation-guidelines",
      "document_id": "bg-openfinance-v2-implementation-guidelines@8eec1c4376ce",
      "version": "openfinance-v2",
      "kind": "pdf",
      "authority": "normative",
      "title": "Open Finance v2 Implementation Guidelines (synthetic fixture)",
      "locator": "chunk:bg-openfinance-v2-implementation-guidelines:p1:c0",
      "page": 1,
      "evidence": "Open Finance Framework Version 2\n\nImplementation Guidelines - Account Information (synthetic fixture)\n\nSYNTHETIC TEST FIXTURE. This document is original test data created for the bg-spec MCP\nserver. It is not a Berlin Group publication and has no normative value",
      "relevance": 4.552999973297119,
      "sha256": "8d738d7f1ec0e53492b86cc521ab086ce686c52198e1052b8da9101d31498a33",
      "classification": "discovered_evidence"
    },
    {
      "record_id": "bg-openfinance-v2-errata:p1:c2",
      "record_type": "chunk",
      "source_id": "bg-openfinance-v2-errata",
      "document_id": "bg-openfinance-v2-errata@809757ca2bde",
      "version": "openfinance-v2",
      "kind": "text",
      "authority": "informative",
      "title": "Open Finance v2 Errata and Clarifications (synthetic fixture) — E-09 bookingStatus value all",
      "locator": "chunk:bg-openfinance-v2-errata:p1:c2",
      "page": 1,
      "evidence": "E-09 bookingStatus value all\n\nThe bookingStatus value all returns booked, pending and information entries in one\nresponse. ASPSPs that do not support information SHALL reject the value all with\nHTTP status 400 and error code FORMAT_ERROR",
      "relevance": 4.191999912261963,
      "sha256": "242958460734148d175faf9c02d2406c738aa114cc4102e7e51ddfebaeb8aa23",
      "classification": "discovered_evidence"
    }
  ],
